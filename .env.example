# El demo determinístico NO requiere API key.
# El chat sí usa OpenAI Responses API desde backend.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_MS=30000
MAX_OUTPUT_TOKENS=3000
MAX_AGENT_ITERATIONS=25
MAX_SESSION_TOKENS=12000

# Frontend permitido. En producción usa la URL pública exacta del front.
CORS_ORIGIN=http://localhost:5173

# Local: dejar vacío. Railway con volume: /data
OUT_DIR=
